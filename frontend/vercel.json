{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash native/build.sh && cp -R ../backend ./backend && mkdir -p dist && cp -R *.html *.jpg css js mapa biomas assets dist/",
  "functions": {
    "api/mapa.js": {
      "includeFiles": "native/gerar_mapa",
      "maxDuration": 20
    },
    "api/[...path].js": {
      "includeFiles": "backend/**",
      "maxDuration": 20
    }
  },
  "outputDirectory": "dist"
}
